<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面小组件布局（功能 12）。
  这份文件是「源」，由 build-ui.ps1 拷进 _apkwork/res/layout/ 再打 apktool b。
  Java 侧用 getIdentifier 取这些 id，缺任何一个只是不渲染、不会崩：
    w_root   整卡点击 → 打开 App（tab=home）
    w_title  标题「烛之控制台」
    w_state  「在线 1/2」「未运行」…  颜色由 Java 设
    w_time   「最近更新 12:34」
    w_toggle 「启动 / 停止」按钮，点击走 WIDGET_TOGGLE
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="烛之控制台"
            android:textColor="#F8FAFC"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_btn"
            android:gravity="center"
            android:minWidth="52dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="启动"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="未运行"
        android:textColor="#94A3B8"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="等待自检"
        android:textColor="#94A3B8"
        android:textSize="10sp" />
</LinearLayout>
