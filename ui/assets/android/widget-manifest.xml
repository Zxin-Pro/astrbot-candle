<!--
  1.3.5-beta.2：用户点单要桌面小组件，重新启用 receiver（只留小组件，快捷设置磁贴继续不上，
  少一个 exported 组件对扫描引擎更友好）。
  build-ui.ps1 用 UTF-8 读这个文件，把整段插到 AndroidManifest.xml 的 </application> 之前。
  放在这里而不是直接写进 ps1：PowerShell 5.1 会把无 BOM 的 .ps1 当 GBK 读，中文标签会被写坏。
  幂等：manifest 里已经有 QqbotWidgetProvider 时整段跳过。
-->
<receiver android:name="com.termux.app.QqbotWidgetProvider" android:exported="false">
    <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
    </intent-filter>
    <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info" />
</receiver>

