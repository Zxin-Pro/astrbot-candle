# =====================================================================
# AstrBot烛版 (qqbot-sandbox) - Git 忽略规则
# =====================================================================

# ---------------------------------------------------------------------
# 一、绝对不入库：第三方素材 / SDK / 构建中间目录
# ---------------------------------------------------------------------
_research/
_sdk/
out/
_apkwork/
_vps/

# Python 缓存（vps-deploy 下的爬虫脚本在本地跑过一次就会生成）
__pycache__/

# 界面（原生控制台）构建中间产物，全部由 build-ui.ps1 生成
ui/classes/
ui/classes8/
ui/dex/
ui/dex8/
ui/smali/
ui/mini/
ui/minidex/
ui/dA/
ui/dB/
ui/dC/

# ---------------------------------------------------------------------
# 二、绝对不入库：二进制 / 打包产物 / 日志
# ---------------------------------------------------------------------
*.apk
*.idsig
*.dex
*.class
*.jar
*.so
*.zip
*.tar.gz
*.xz
*.deb
*.log
hs_err_pid*.log
replay_pid*.log

# ---------------------------------------------------------------------
# 三、必须入库：源码、脚本与文档
#    （用 ! 显式反选，防止上面的通配规则误伤）
# ---------------------------------------------------------------------
!build/
!build/**
!tools/
!tools/**
!ui/src/
!ui/src/**
!ui/assets/
!ui/assets/**
!docs/
!docs/**
!*.ps1
!*.md
!*.sh
!*.java

# 仓库自身的说明性文件
!.gitignore
!LICENSE
!README.md
!CHANGELOG.md

# ---------------------------------------------------------------------
# 四、构建中间产物 / 生成文件（由 tools 里的 Java 工具产出，可随时重生成）
#     这些规则放在上面 !tools/** 之后，才会真正生效
# ---------------------------------------------------------------------
tools/*.class
tools/ext/
tools/entries.txt
ui/Mini.java
ui/*.java
