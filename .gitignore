# =====================================================================
# AstrBot烛版 (qqbot-sandbox) - Git 忽略规则
# =====================================================================

# ---------------------------------------------------------------------
# 一、绝对不入库：第三方素材 / SDK / 构建中间目录
# ---------------------------------------------------------------------
_research/
_sdk/
out/
_apkwork/
_ref/
_vps/

# Python 缓存（vps-deploy 下的爬虫脚本在本地跑过一次就会生成）
__pycache__/

# 界面（原生控制台）构建中间产物，全部由 build-ui.ps1 生成
ui/classes/
ui/classes8/
ui/dex/
ui/dex8/
ui/smali/
ui/mini/
ui/minidex/
ui/dA/
ui/dB/
ui/dC/

# ---------------------------------------------------------------------
# 二、绝对不入库：二进制 / 打包产物 / 日志
# ---------------------------------------------------------------------
*.apk
*.idsig
*.dex
*.class
*.jar
*.so
*.zip
*.tar.gz
*.xz
*.deb
*.log
hs_err_pid*.log
replay_pid*.log

# ---------------------------------------------------------------------
# 三、必须入库：源码、脚本与文档
#    （用 ! 显式反选，防止上面的通配规则误伤）
# ---------------------------------------------------------------------
!build/
!build/**
!tools/
!tools/**
!ui/src/
!ui/src/**
!ui/assets/
!ui/assets/**
!docs/
!docs/**
!*.ps1
!*.md
!*.sh
!*.java

# 仓库自身的说明性文件
!.gitignore
!LICENSE
!README.md
!CHANGELOG.md

# ---------------------------------------------------------------------
# 四、构建中间产物 / 生成文件（由 tools 里的 Java 工具产出，可随时重生成）
#     这些规则放在上面 !tools/** 之后，才会真正生效
# ---------------------------------------------------------------------
tools/*.class
tools/ext/
tools/entries.txt
ui/Mini.java
ui/*.java

# 内置离线包的架构/体积标记：由 build-apk.ps1 -Arch 每次重建时写入，不入库
build/opt/qqbot/BUNDLE_ARCH
build/opt/qqbot/BUNDLE_SIZE
tools/__pycache__/

# ---------------------------------------------------------------------
# 五、iOS 版：由 ios/tools 生成的产物，构建前重新生成，避免和源码漂移
#     （.xcodeproj 里的 Sources 列表是生成出来的，手工增删 .swift 后必须重跑
#     python ios/tools/gen_xcodeproj.py；资源副本同理，CI 每次都会重建）
# ---------------------------------------------------------------------
ios/AstrBotIOS.xcodeproj/
ios/AstrBotIOS/Resources/web/
ios/AstrBotIOS/Resources/shared/
ios/AstrBotIOS/Resources/Assets.xcassets/AppIcon.appiconset/AppIcon-1024.png
